---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredRepos } from "../data/projects";
import type { Project } from "../data/projects";
import { fetchFeaturedRepos, socialPreviewImage } from "../lib/github";

// Esto corre en build time (al hacer `astro build` / al desplegar en Vercel),
// no en el navegador del visitante. Una sola llamada a la API de GitHub trae
// los datos de todos los repos marcados como "featured".
const githubRepos = await fetchFeaturedRepos(featuredRepos.map((f) => f.repo));

// Orden: el de featuredRepos en src/data/projects.ts (más nuevo primero, manual).
const projects: Project[] = featuredRepos.map((entry) => {
  const repo = githubRepos.get(entry.repo);

  const techFromRepo = repo?.topics?.length
    ? repo.topics
    : repo?.language
      ? [repo.language]
      : [];

  const image = entry.image ?? (repo ? socialPreviewImage(repo.name) : undefined);

  return {
    name: entry.name ?? repo?.name ?? entry.repo,
    description:
      entry.description ?? repo?.description ?? "Sin descripción disponible en GitHub.",
    demoUrl: entry.demoUrl ?? repo?.homepage ?? undefined,
    githubUrl: repo?.html_url ?? `https://github.com/mecottl/${entry.repo}`,
    image,
    tech: entry.tech ?? techFromRepo,
    inProgress: entry.inProgress ?? !image,
  };
});
---

<Layout title="Proyectos - Gerardo Mecott" titlepage="Portafolio">
  <div class="projects-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Layout>
